#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
  zip_scroll_scaler: zip_scroll_scaler {
    compatible = "zmk,input-processor-scaler";
    #input-processor-cells = <2>;
    type = <INPUT_EV_REL>;
    codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    track-remainders;
  };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    tl_hr_left: tl_hr_left {
        compatible = "zmk,behavior-hold-tap";
        label = "TL_HR_LEFT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <220>;
        flavor = "balanced";
        quick-tap-ms = <168>;
        require-prior-idle-ms = <138>;
        hold-trigger-key-positions = <1 2 3 4 5 14 15 16 17 18 27 28 29 30 31 40 41 42 43 44 0 13 26 39 53 54 55 56 57 59 60 61 62 63 51 38 12>;
        hold-trigger-on-release;
    };

    tl_hr_right: tl_hr_right {
        compatible = "zmk,behavior-hold-tap";
        label = "TL_HR_RIGHT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <220>;
        flavor = "balanced";
        quick-tap-ms = <168>;
        require-prior-idle-ms = <138>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <53 54 55 56 57 59 60 61 62 63 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 59 60 61 62 63 13 26 39>;
    };

    td_layer1: td_layer1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER1";
        #binding-cells = <0>;
        bindings = <&lt 1 ESCAPE>, <&kp ESCAPE>;

        tapping-term-ms = <168>;
    };

    td_layer2: td_layer2 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER2";
        #binding-cells = <0>;
        bindings = <&lt 2 TAB>, <&kp TAB>;

        tapping-term-ms = <168>;
    };

    td_layer3: td_layer3 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER3";
        #binding-cells = <0>;
        bindings = <&lt 3 SPACE>, <&kp SPACE>;

        tapping-term-ms = <168>;
    };

    td_layer4: td_layer4 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER4";
        #binding-cells = <0>;
        bindings = <&lt 4 ENTER>, <&kp ENTER>;

        tapping-term-ms = <168>;
    };

    td_layerfn: td_layerfn {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYERFN";
        #binding-cells = <0>;
        bindings = <&lt 7 LANG_HANGEUL>;
        tapping-term-ms = <180>;
    };

    td_space: td_space {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SPACE";
        #binding-cells = <0>;
        bindings = <&mt LEFT_SHIFT SPACE>, <&kp SPACE>;

        tapping-term-ms = <156>;
    };

    td_delete: td_delete {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_DELETE";
        #binding-cells = <0>;
        bindings = <&mt RIGHT_SHIFT BACKSPACE>, <&kp BACKSPACE>;

        tapping-term-ms = <156>;
    };

    ht_caps_word: ht_caps_word {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_CAPS_WORD";
        bindings = <&kp>, <&caps_word>;

        #binding-cells = <2>;
        tapping-term-ms = <156>;
    };

    td_layer5: td_layer5 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER5";
        #binding-cells = <0>;
        bindings = <&lt 5 BACKSPACE>, <&kp BACKSPACE>;

        tapping-term-ms = <168>;
    };

    td_layer6: td_layer6 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_LAYER6";
        #binding-cells = <0>;
        bindings = <&lt 6 DELETE>, <&kp DELETE>;

        tapping-term-ms = <168>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        left_sys {
            bindings = <&bootloader>;
            key-positions = <0 57 1>;
        };

        right_sys {
            bindings = <&bootloader>;
            key-positions = <11 12 59>;
        };

        left_rst {
            bindings = <&sys_reset>;
            key-positions = <0 5 57>;
        };

        right_rst {
            bindings = <&sys_reset>;
            key-positions = <59 12 7>;
        };

        arrow_double_right {
            bindings = <&macro_arrow_double_right>;
            key-positions = <35 49>;
            layers = <3>;
        };

        arrow_double_left {
            bindings = <&macro_arrow_double_left>;
            key-positions = <35 48>;
            layers = <3>;
        };

        arrow_single_right {
            bindings = <&macro_arrow_single_right>;
            key-positions = <34 49>;
            layers = <3>;
        };

        arrow_single_left {
            bindings = <&macro_arrow_single_left>;
            key-positions = <34 48>;
            layers = <3>;
        };

        brace_s {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <33 35>;
            layers = <3>;
        };

        brace_m {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <33 36>;
            layers = <3>;
        };

        brace_l {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <33 37>;
            layers = <3>;
        };
    };

    macros {
        macro_arrow_double_right: macro_arrow_double_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "MACRO_ARROW_DOUBLE_RIGHT";
        };

        macro_arrow_double_left: macro_arrow_double_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp EQUAL>;
            label = "MACRO_ARROW_DOUBLE_LEFT";
        };

        macro_arrow_single_right: macro_arrow_single_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_ARROW_SINGLE_RIGHT";
        };

        macro_arrow_single_left: macro_arrow_single_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp MINUS>;
            label = "MACRO_ARROW_SINGLE_LEFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp CAPSLOCK  &kp N1                  &kp N2              &kp N3                      &kp N4                    &kp N5    &kp UP_ARROW     &kp N6  &kp N7                     &kp N8                       &kp N9               &kp N0                       &kp BSPC
&kp GRAVE     &kp Q                   &kp W               &kp E                       &kp R                     &kp T     &kp DOWN_ARROW   &kp Y   &kp U                      &kp I                        &kp O                &kp P                        &kp BSLH
&td_layerfn   &tl_hr_left LEFT_GUI A  &tl_hr_left LALT S  &tl_hr_left LEFT_CONTROL D  &tl_hr_left LEFT_SHIFT F  &kp G     &kp LEFT_ARROW   &kp H   &tl_hr_right LEFT_SHIFT J  &tl_hr_right LEFT_CONTROL K  &tl_hr_right LALT L  &tl_hr_right LGUI SEMICOLON  &kp APOS
&kp LSHIFT    &kp Z                   &kp X               &kp C                       &kp V                     &kp B     &kp RIGHT_ARROW  &kp N   &kp M                      &kp COMMA                    &kp DOT              &kp FSLH                     &kp RIGHT_SHIFT
&kp C_MUTE    &none                   &td_layer1          &td_layer2                  &td_layer3                &none     &kp ENTER        &none   &td_layer4                 &td_layer5                   &td_layer6           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        Function {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &trans    &trans           &trans          &trans           &trans      &trans
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &kp F7    &kp F8           &kp F9          &kp F10          &kp F11     &kp F12
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans  &kp F1    &kp F2           &kp F3          &kp F4           &kp F5      &kp F6
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &kp HOME  &kp PAGE_DOWN    &kp PAGE_UP     &kp END          &kp INSERT  &kp DELETE
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &trans    &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans
            >;
        };

        Number {
            bindings = <
&trans  &trans      &trans    &trans     &trans     &trans       &trans  &trans     &trans     &trans   &trans     &trans    &trans
&trans  &kp N1      &kp N2    &kp N3     &kp N4     &kp N5       &trans  &kp N6     &kp N7     &kp N8   &kp N9     &kp N0    &trans
&trans  &kp LGUI    &kp LALT  &kp LCTRL  &kp LSHFT  &kp PG_UP    &trans  &kp MINUS  &kp N4     &kp N5   &kp N6     &kp PLUS  &trans
&trans  &kp INSERT  &kp DEL   &kp HOME   &kp END    &kp PG_DN    &trans  &kp N0     &kp N1     &kp N2   &kp N3     &kp FSLH  &trans
&trans  &trans      &trans    &trans     &trans     &trans       &trans  &trans     &kp COMMA  &kp DOT  &kp EQUAL  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        symbol {
            bindings = <
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &trans  &kp EXCLAMATION  &kp AT_SIGN     &kp HASH          &kp DOLLAR            &kp PERCENT            &kp DELETE
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp POUND     &kp DOLLAR            &kp PERCENT              &trans  &kp CARET        &kp AMPERSAND   &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LGUI         &kp LALT       &kp LCTRL     &kp LSHFT             &trans                   &trans  &kp COLON        &kp MINUS       &kp EQUAL         &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans
&trans  &trans           &trans         &trans        &trans                &trans                   &trans  &kp SEMICOLON    &kp UNDERSCORE  &kp PLUS          &kp LBKT              &kp RBKT               &trans
&trans  &trans           &trans         &trans        &trans                &trans                   &trans  &trans           &kp LESS_THAN   &kp GREATER_THAN  &kp QUESTION          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        mouse {
            bindings = <
&trans  &trans      &trans          &trans          &trans           &trans            &mmv MOVE_UP     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &mkp MB5    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP      &mmv MOVE_DOWN   &trans  &trans     &trans     &trans    &trans    &trans
&trans  &mkp MB4    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &mmv MOVE_LEFT   &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp K_UNDO  &kp K_CUT       &kp K_COPY      &kp K_PASTE      &kp K_REDO        &mmv MOVE_RIGHT  &trans  &trans     &trans     &trans    &trans    &trans
&trans  &trans      &mkp MCLK       &mkp RCLK       &mkp LCLK        &trans            &mkp LCLK        &trans  &trans     &trans     &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        navigation {
            bindings = <
&trans  &trans      &trans     &trans      &trans       &trans        &trans  &trans         &trans     &trans     &trans    &trans     &trans
&trans  &kp INSERT  &kp HOME   &kp UP      &kp END      &kp PG_UP     &trans  &kp HOME       &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &kp END
&trans  &kp DELETE  &kp LEFT   &kp DOWN    &kp RIGHT    &kp PG_DN     &trans  &kp PAGE_UP    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &trans
&trans  &kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp K_REDO    &trans  &kp PAGE_DOWN  &trans     &trans     &trans    &trans     &trans
&trans  &trans      &trans     &trans      &trans       &trans        &trans  &trans         &trans     &trans     &trans    &trans
            >;
        };

        media {
            bindings = <
&bt BT_CLR  &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2     &bt BT_DISC 3  &bt BT_DISC 4    &trans  &rgb_ug RGB_ON   &rgb_ug RGB_EFR  &rgb_ug RGB_HUI    &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI
&trans      &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2      &bt BT_SEL 3   &bt BT_SEL 4     &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_EFF  &rgb_ug RGB_HUD    &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD
&trans      &kp C_PREVIOUS  &kp C_VOL_DN   &kp C_VOL_UP      &kp C_NEXT     &trans           &trans  &rgb_ug RGB_TOG  &kp C_PREVIOUS   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &trans
&trans      &out OUT_BLE    &out OUT_USB   &trans            &trans         &out OUT_TOG     &trans  &trans           &trans           &trans             &trans           &trans           &trans
&kp C_MUTE  &trans          &kp C_STOP     &kp C_PLAY_PAUSE  &kp C_MUTE     &trans           &trans  &trans           &trans           &trans             &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        fn {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans     &trans     &trans     &trans        &trans
&trans  &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans     &trans     &trans     &trans        &trans
&trans  &kp LG(A)  &kp LA(S)  &kp LC(D)  &kp LS(F)  &trans    &trans  &trans  &kp LS(J)  &kp LC(K)  &kp LA(L)  &kp LG(SEMI)  &trans
&trans  &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans     &trans     &trans     &trans        &trans
&trans  &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mouse_layer {
            if-layers = <2 6>;
            then-layer = <4>;
        };
    };
};
